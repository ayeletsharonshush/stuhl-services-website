/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/videos
  Cache-Control: no-cache, no-store, must-revalidate

/recommends
  Cache-Control: no-cache, no-store, must-revalidate

/portfolio
  Cache-Control: no-cache, no-store, must-revalidate

/contact
  Cache-Control: no-cache, no-store, must-revalidate

# Vite's JS, CSS and fonts carry a content hash in their names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The WebP photos are named by content too (scripts/optimize-images.mjs), so a
# changed photo gets a new URL. The videos and og-image.png are not: give a
# replacement a new file name rather than overwriting one.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/products/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
